# Host directory mounted into the EvoPIE containers at /app/data.
# Local profile defaults to ./data when this is blank.
# Production profile requires a persistent host directory.
EVOPIE_DATA_DIR=

# SQLite database used by the web and updater services.
EVOPIE_DATABASE_URI=sqlite:////app/data/db.sqlite

# Nginx server name and certificate domain.
# Leave these blank for local HTTP. Set real values for production HTTPS.
EVOPIE_SERVER_NAME=
EVOPIE_CERT_DOMAIN=

# Host directory mounted into nginx at /etc/nginx/certs.
# Production profile requires the directory containing trusted certs.
EVOPIE_CERTS_DIR=
