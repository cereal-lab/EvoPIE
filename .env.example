# Host directory mounted into the EvoPIE containers at /app/data.
EVOPIE_DATA_DIR=./data

# SQLite database used by the web and updater services.
EVOPIE_DATABASE_URI=sqlite:////app/data/db.sqlite

# Required nginx mode. Use http for local use or https for TLS.
EVOPIE_NGINX_MODE=http

# Nginx server name and certificate domain.
EVOPIE_SERVER_NAME=localhost
EVOPIE_CERT_DOMAIN=localhost

# Host directory mounted into nginx at /etc/nginx/certs.
EVOPIE_CERTS_DIR=./certs
